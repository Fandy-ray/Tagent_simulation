# OpenNoteBook 嵌入地址（笔记本页 iframe）
# 不填时默认 http://localhost:8502/notebooks
PUBLIC_OPENNOTEBOOK_URL=http://localhost:8502/notebooks

# OpenNoteBook REST API（测评页读取笔记本 / 来源）
# 不填时：若 UI 是 8502，则自动用 http://localhost:5055
# 部署到只对外开前端端口的服务器时写 /opennotebook-api：经 Vite 代理转到本机 5055（见 vite.config.ts）
PUBLIC_OPENNOTEBOOK_API_URL=http://localhost:5055

# basic-agent。开发时走 Vite 代理 /agent-api -> http://127.0.0.1:5001
# macOS 的隔空播放常占用 5000，所以本机改到 5001
PUBLIC_AGENT_URL=/agent-api
