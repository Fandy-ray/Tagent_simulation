# Prefer the root .env.runtime generated by scripts/init_windows.ps1 or
# scripts/init_linux.sh. Never commit real values from a local .env file.
AGENT_ADMIN_TOKEN=
AGENT_INTERNAL_TOKEN=

# Service listen address.
BASIC_AGENT_HOST=127.0.0.1
BASIC_AGENT_PORT=5000

# Set to 1 to use waitress instead of Flask's development server.
USE_WAITRESS=1

# Optional HuggingFace mirror.
HF_ENDPOINT=https://hf-mirror.com

# OpenNotebook runs two processes:
#   8502 = Streamlit UI (what you open in a browser, at /notebooks)
#   5055 = REST API (what TAgent actually calls, /api/*)
# Point this at the REST API. If you paste the browser URL instead, TAgent
# rewrites 8502 -> 5055 and drops the /notebooks path for you.
OPEN_NOTEBOOK_API_URL=http://localhost:5055
# Browser URL. Only used when OPEN_NOTEBOOK_API_URL is empty.
OPEN_NOTEBOOK_URL=http://localhost:8502/notebooks
OPEN_NOTEBOOK_PASSWORD=
# KNOWLEDGE_SOURCE=local|notebook|composite
KNOWLEDGE_SOURCE=

# Persistent local indexes use actual model revisions; old caches are retained.
TAGENT_VECTOR_CACHE=1
# Empty = the normal TAgent application-data directory. 0 above disables disk writes.
RAG_INDEX_CACHE_DIR=
# Cache only local retrieval results, not model answers or remote notebook results.
RAG_RETRIEVAL_CACHE=1
RAG_RETRIEVAL_CACHE_MAX_ENTRIES=128
RAG_RETRIEVAL_CACHE_TTL_SECONDS=60

# Concurrency. A request holds one server thread for its whole duration (a streamed answer holds it
# until the last token), and so does a request waiting at the answer gate, so this is how many people
# can be connected at once; the rest queue, /health included. 2026-10-31 load test on 2 cores / 2 GB:
# 200 people within 10 s all got through with 300 threads and ANSWER_MAX_CONCURRENT=32.
WAITRESS_THREADS=300
# Exam generation / essay review jobs running at once. Each fires 3 upstream calls, so upstream peak = 3x.
EXAM_MAX_CONCURRENT_LLM=10

# Optional legacy variables for the standalone pdf.py/pdf_ocr.py utilities.
# They do not register a provider for the TAgent v1 HTTP service.
OPENAI_AUTH_MODE=bearer
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
