# 账号功能默认关闭。公网启用前须有可信 HTTPS（可使用 IP 证书）和专用身份库。
TAGENT_AUTH_ENABLED=0
# 后端必须只监听本机；账号模式下配置为 0.0.0.0 或公网地址会拒绝启动。
BASIC_AGENT_HOST=127.0.0.1
TAGENT_PUBLIC_ORIGIN=https://your-public-ip
# 完整版 OpenNotebook 使用同一 HTTPS 主机的独立端口；仅其账号接口可作为第二个写请求来源。
OPEN_NOTEBOOK_PUBLIC_ORIGIN=https://your-public-ip:8502
# Private loopback API and a separate 32+ byte key shared with OpenNotebook.
# Required before enabling login; use the same key as OPEN_NOTEBOOK_TAGENT_LIFECYCLE_KEY.
TAGENT_NOTEBOOK_LIFECYCLE_URL=http://127.0.0.1:5055
TAGENT_NOTEBOOK_LIFECYCLE_KEY=
TAGENT_AUTH_COOKIE_SECURE=1
TAGENT_REGISTRATION_OPEN=1

# 使用已有 SurrealDB 服务，但单独创建 TAgent namespace/database 和运行账号。
TAGENT_DB_URL=
TAGENT_DB_NAMESPACE=tagent
TAGENT_DB_DATABASE=app
TAGENT_DB_USER=
TAGENT_DB_PASSWORD=

# 第一个是当前写入密钥；轮换时旧密钥留在后面，以逗号隔开。
# 每个值是 Fernet.generate_key() 生成的 URL-safe base64 密钥。
TAGENT_DATA_KEYS=

# disabled：学生用唯一邮箱自行注册，邮箱仅作为登录标识、不验证归属；忘记密码由管理员核验后在终端重置。
# smtp：学生使用邮箱注册、验证及邮件找回；memory 仅供 TESTING 模式使用。
TAGENT_MAIL_MODE=disabled
TAGENT_SMTP_HOST=
TAGENT_SMTP_PORT=587
TAGENT_SMTP_USER=
TAGENT_SMTP_PASSWORD=
TAGENT_SMTP_FROM=
