# 账号功能默认关闭。域名、HTTPS、SMTP 和专用身份库就绪后才设置为 1。
TAGENT_AUTH_ENABLED=0
TAGENT_PUBLIC_ORIGIN=https://tagent.example.edu
TAGENT_AUTH_COOKIE_SECURE=1
TAGENT_REGISTRATION_OPEN=0

# 使用已有 SurrealDB 服务，但单独创建 TAgent namespace/database 和运行账号。
TAGENT_DB_URL=
TAGENT_DB_NAMESPACE=tagent
TAGENT_DB_DATABASE=app
TAGENT_DB_USER=
TAGENT_DB_PASSWORD=

# 第一个是当前写入密钥；轮换时旧密钥留在后面，以逗号隔开。
# 每个值是 Fernet.generate_key() 生成的 URL-safe base64 密钥。
TAGENT_DATA_KEYS=

# 正式环境必须使用 SMTP；memory 仅供 TESTING 模式使用。
TAGENT_MAIL_MODE=smtp
TAGENT_SMTP_HOST=
TAGENT_SMTP_PORT=587
TAGENT_SMTP_USER=
TAGENT_SMTP_PASSWORD=
TAGENT_SMTP_FROM=
