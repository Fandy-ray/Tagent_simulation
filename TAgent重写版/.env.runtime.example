BASIC_AGENT_HOST=127.0.0.1
BASIC_AGENT_PORT=5001
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8080
BASIC_AGENT_BASE_URL=http://127.0.0.1:5001

# OpenNotebook runs two processes: 8502 is the Streamlit UI, 5055 is the REST
# API. TAgent calls /api/*, so it needs 5055. Pasting the 8502 browser URL into
# OPEN_NOTEBOOK_URL also works — TAgent rewrites the port and strips /notebooks.
OPEN_NOTEBOOK_API_URL=http://localhost:5055
OPEN_NOTEBOOK_URL=http://localhost:8502/notebooks
OPEN_NOTEBOOK_PASSWORD=
KNOWLEDGE_SOURCE=

# Generated by scripts/init_windows.ps1 or scripts/init_linux.sh.
AGENT_ADMIN_TOKEN=
BASIC_AGENT_ADMIN_TOKEN=
AGENT_INTERNAL_TOKEN=
BASIC_AGENT_INTERNAL_TOKEN=
AGENT_PROVIDER_ENCRYPTION_KEY=
WEBUI_SECRET_KEY=

# Empty by default. Administrators may explicitly allow private/local providers.
AGENT_PROVIDER_ALLOWED_HOSTS=
AGENT_PROVIDER_ALLOWED_CIDRS=
